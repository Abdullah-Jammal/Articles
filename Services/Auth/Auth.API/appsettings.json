{
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=AuthDB;Trusted_Connection=true;"
  },
  "JwtOptions": {
    "Issuer": "Articles",
    "Audience": "Articles",
    "SecretKey": "YourSuperSecretKeyHere",
    "ValidForMinutes": 432000
  },
  "EmailOptions": {
    "EmailServiceProvider": "smtp",
    "EmailFromAddress": "your_email@example.com",
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "Username": "your_username",
      "Password": "your_password",
      "DeliveryMethod": "Network",
      "PickupDirectoryLocation": "out_emails",
      "UseSSL": "false"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
